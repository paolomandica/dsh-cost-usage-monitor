{
  "name": "dsh-cost-usage-monitor",
  "version": "1.0.0",
  "description": "DeepSeek account balance and per-session usage cost in the Harness composer dock.",
  "keywords": [
    "dsh-plugin",
    "deepseek",
    "deepseek-harness",
    "dsh",
    "harness",
    "usage",
    "balance",
    "cost",
    "tokens",
    "plugin"
  ],
  "license": "MIT",
  "author": "paolomandica",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paolomandica/dsh-cost-usage-monitor.git"
  },
  "homepage": "https://github.com/paolomandica/dsh-cost-usage-monitor#readme",
  "bugs": {
    "url": "https://github.com/paolomandica/dsh-cost-usage-monitor/issues"
  },
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "icon": "./icon.svg",
  "meta": {
    "title": "Usage & balance",
    "description": "Shows the DeepSeek account balance and an estimated cost for the current session, priced from provider-reported token usage."
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "assets",
    "locale",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
